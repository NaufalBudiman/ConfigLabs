#!/usr/bin/env python3
"""Fill /etc/configlabs.env and /etc/racktrack.env without opening an editor.

  sudo fill-env              fill what is still empty (both files)
  sudo fill-env configlabs   only one file
  sudo fill-env --check      show which variables are filled / missing (names only, no values)
  sudo fill-env --force      ask again for the pasted credentials, even if they are filled

- App secrets (SESSION_SECRET, JWT_SECRET, AUTH_SECRET, CRON_SECRET) are generated here, at random.
  They are only generated when empty, so running this again never logs anybody out.
- Credentials from other services (database URL, Google client secret, Resend key) are asked for with hidden
  input: nothing is shown on screen, written to a log or kept in the shell history.
- Values are written as KEY='value', which both systemd and `. /etc/racktrack.env` read the same way.
- Existing values are kept unless you pass --force. Nothing is ever printed back.
"""
import argparse
import getpass
import os
import re
import secrets
import sys

ENV_DIR = os.environ.get("CL_ENV_DIR", "/etc")

# (name, kind, required, hint)   kind: hex / urlsafe = generated, text = visible prompt, secret = hidden prompt
SPECS = {
    "configlabs": [
        ("SESSION_SECRET", "hex", True, ""),
        ("JWT_SECRET", "hex", True, ""),
        ("DATABASE_URL", "secret", True, "starts with postgresql://"),
        ("GOOGLE_CLIENT_ID", "text", True, "ends with .apps.googleusercontent.com"),
        ("GOOGLE_CLIENT_SECRET", "secret", True, ""),
        ("PRO_EMAILS", "text", False, "emails separated by commas"),
    ],
    "racktrack": [
        ("AUTH_SECRET", "urlsafe", True, ""),
        ("CRON_SECRET", "hex", True, ""),
        ("DATABASE_URL", "secret", True, "starts with postgresql://"),
        ("AUTH_GOOGLE_ID", "text", True, "ends with .apps.googleusercontent.com"),
        ("AUTH_GOOGLE_SECRET", "secret", True, ""),
        ("RESEND_API_KEY", "secret", False, "without it the digest only does a dry run"),
    ],
}
# the Google client ID variable of each app -> (the other app's ID variable, the other app's secret variable)
GOOGLE_PAIRS = {"GOOGLE_CLIENT_ID": ("AUTH_GOOGLE_ID", "AUTH_GOOGLE_SECRET"), "AUTH_GOOGLE_ID": ("GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET")}
TITLES = {"configlabs": "ConfigLabs  (/etc/configlabs.env)", "racktrack": "RackTrack   (/etc/racktrack.env)"}


def unquote(v):
    v = v.strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
        return v[1:-1]
    return v


def parse(path):
    vals = {}
    with open(path, encoding="utf-8") as f:
        for line in f:
            m = re.match(r"^([A-Z][A-Z0-9_]*)=(.*)$", line.rstrip("\n"))
            if m:
                vals[m.group(1)] = unquote(m.group(2))
    return vals


def write(path, updates):
    """Replace or append KEY='value' lines; keep comments, owner and permissions; swap the file in atomically."""
    st = os.stat(path)
    with open(path, encoding="utf-8") as f:
        lines = f.read().split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    done = set()
    for i, line in enumerate(lines):
        m = re.match(r"^([A-Z][A-Z0-9_]*)=", line)
        if m and m.group(1) in updates:
            lines[i] = "%s='%s'" % (m.group(1), updates[m.group(1)])
            done.add(m.group(1))
    for k, v in updates.items():
        if k not in done:
            lines.append("%s='%s'" % (k, v))
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    if os.geteuid() == 0:
        os.chown(tmp, st.st_uid, st.st_gid)
    os.chmod(tmp, st.st_mode & 0o777)
    os.replace(tmp, path)


def generate(kind):
    return secrets.token_hex(32) if kind == "hex" else secrets.token_urlsafe(33)


def valid(name, v):
    if re.search(r"[\s'\x00-\x1f]", v):
        return "must not contain spaces, quotes or line breaks"
    if name == "DATABASE_URL" and not re.match(r"^postgres(ql)?://", v):
        return "should start with postgresql://"
    return None


def main():
    ap = argparse.ArgumentParser(description="Fill the ConfigLabs / RackTrack env files.")
    ap.add_argument("apps", nargs="*", help="configlabs and/or racktrack (default: both)")
    ap.add_argument("--check", action="store_true", help="only show what is filled / missing")
    ap.add_argument("--force", action="store_true", help="ask again for pasted credentials")
    ap.add_argument("--stdin", action="store_true", help="read answers from stdin (tests only)")
    a = ap.parse_args()
    bad = [x for x in a.apps if x not in SPECS]
    if bad:
        ap.error("unknown app %s (use: %s)" % (", ".join(bad), ", ".join(SPECS)))
    apps = a.apps or list(SPECS)

    if os.geteuid() != 0 and ENV_DIR == "/etc":
        sys.exit("Run it with sudo:  sudo fill-env")

    def read(prompt, hidden):
        if a.stdin:
            sys.stdout.write(prompt)
            sys.stdout.flush()
            line = sys.stdin.readline()
            if line == "":
                raise EOFError
            return line.rstrip("\n")
        return getpass.getpass(prompt) if hidden else input(prompt)

    # every file that exists is read, so "same Google client" can use the app that is not being filled now
    paths, vals_of = {}, {}
    for k in SPECS:
        paths[k] = os.path.join(ENV_DIR, k + ".env")
        if os.path.exists(paths[k]):
            vals_of[k] = parse(paths[k])
        elif k in apps:
            sys.exit("%s does not exist yet: run setup-server.sh first." % paths[k])

    def put(app, name, value):
        """Save one value at once, so an interrupted run loses nothing."""
        vals_of[app][name] = value
        write(paths[app], {name: value})

    missing_total = 0
    try:
        for app in apps:
            print("\n== " + TITLES[app])
            vals, saved = vals_of[app], 0
            for name, kind, required, hint in SPECS[app]:
                have = vals.get(name, "")
                if a.check:
                    print("  %-22s %s" % (name, "filled" if have else ("MISSING" if required else "empty (optional)")))
                    missing_total += 1 if (required and not have) else 0
                    continue
                if kind in ("hex", "urlsafe"):
                    if have:
                        print("  = %s already set, kept" % name)
                    else:
                        put(app, name, generate(kind)); saved += 1
                        print("  + %s generated" % name)
                    continue
                if have and not a.force:
                    print("  = %s already set, kept" % name)
                    continue
                # one Google client for both apps: offer the other app's ID and secret in one go
                if name in GOOGLE_PAIRS:
                    other = [k for k in SPECS if k != app][0]
                    oid, osec = GOOGLE_PAIRS[name]
                    ov = vals_of.get(other, {})
                    if ov.get(oid) and ov.get(osec):
                        if read("  %s: use the same Google client as %s? [y/N] " % (name, other), False).strip().lower() == "y":
                            sec_name = [n for n, *_ in SPECS[app] if n.endswith(("GOOGLE_SECRET", "CLIENT_SECRET"))][0]
                            put(app, name, ov[oid]); put(app, sec_name, ov[osec]); saved += 2
                            print("  + %s and %s copied from %s" % (name, sec_name, other))
                            continue
                while True:
                    label = "  %s%s%s: " % (name, " (%s)" % hint if hint else "", "" if required else " [Enter to skip]")
                    v = read(label, kind == "secret").strip()
                    if not v:
                        if required:
                            print("    this one is required")
                            continue
                        break
                    problem = valid(name, v)
                    if problem:
                        print("    not saved: " + problem)
                        continue
                    if name.endswith(("GOOGLE_ID", "CLIENT_ID")) and "apps.googleusercontent.com" not in v:
                        print("    note: a Google client ID normally ends with .apps.googleusercontent.com")
                    put(app, name, v); saved += 1
                    print("    ok (%d characters)" % len(v))
                    break
            if saved:
                print("  saved %d value(s) to %s" % (saved, paths[app]))
            if not a.check:
                for name, kind, required, hint in SPECS[app]:
                    if required and not vals.get(name):
                        missing_total += 1
                        print("  still missing: " + name)
    except (EOFError, KeyboardInterrupt):
        print("\n\nStopped. Everything entered so far is already saved; run it again to continue.")
        sys.exit(130)

    print()
    if a.check:
        print("%d required variable(s) missing." % missing_total if missing_total else "All required variables are filled.")
    elif missing_total:
        print("%d required variable(s) are still empty: run it again when you have them." % missing_total)
    else:
        print("Ready. Next:  sudo bash /tmp/configlabs/server/setup-server.sh")
    sys.exit(1 if missing_total else 0)


if __name__ == "__main__":
    main()
