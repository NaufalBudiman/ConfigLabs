# /etc/configlabs.env : copy the values from Vercel (ConfigLabs project > Settings > Environment Variables).
# Never commit the filled file. Only root and the configlabs user can read it on the server.
DATABASE_URL=
SESSION_SECRET=
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# comma-separated emails that get the Translator's Pro plan (optional)
PRO_EMAILS=
