# /etc/racktrack.env : copy the values from Vercel (RackTrack project > Settings > Environment Variables).
# Never commit the filled file. Only root and the racktrack user can read it on the server.
DATABASE_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
CRON_SECRET=
RESEND_API_KEY=
DIGEST_FROM=
# needed outside Vercel so Auth.js builds the right callback URLs and trusts the nginx proxy
AUTH_URL=https://racktrack.online
AUTH_TRUST_HOST=true
