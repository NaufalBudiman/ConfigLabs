{
  "redirects": [
    { "source": "/topology.html", "destination": "/builder.html", "permanent": true },
    { "source": "/topology", "destination": "/builder.html", "permanent": true },
    { "source": "/solutions-showcase-v3.html", "destination": "/", "permanent": true },
    { "source": "/about", "destination": "/about.html", "permanent": true },
    { "source": "/builder", "destination": "/builder.html", "permanent": true },
    { "source": "/wifi", "destination": "/wifi.html", "permanent": true }
  ],
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/templates", "destination": "/api/index" },
    { "source": "/generate", "destination": "/api/index" },
    { "source": "/vendors", "destination": "/api/index" },
    { "source": "/feedback", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": { "includeFiles": "{ConfigLab.py,models.py}", "maxDuration": 30 }
  }
}
